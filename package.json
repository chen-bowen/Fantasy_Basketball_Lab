{
  "name": "fantasy-draft-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": ".venv/bin/uvicorn app.main:app --app-dir backend --port 8000",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "cd backend && ../.venv/bin/python -m pytest tests/ -q",
    "smoke": "node scripts/smoke.mjs",
    "data:fetch": "cd backend && ../.venv/bin/python -m scripts.fetch_players"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
