{
  "name": "fantasy-draft-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "dev:backend": ".venv/bin/uvicorn app.main:app --app-dir backend --port 8000",
    "build": "npm --prefix web run build",
    "test": "cd backend && ../.venv/bin/python -m pytest tests/ -q",
    "smoke": "npm --prefix web run smoke",
    "data:fetch": "cd backend && ../.venv/bin/python -m scripts.fetch_players",
    "setup:web": "npm --prefix web install"
  },
  "devDependencies": {}
}
