# Database Configuration
# Option 1: Supabase (Recommended for production/cloud)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Option 2: Local Docker PostgreSQL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/category_edge

# Option 3: Local PostgreSQL
# DATABASE_URL=postgresql://your_user@localhost:5432/category_edge

# Redis Configuration
# Option 1: Local Redis (Docker)
REDIS_URL=redis://localhost:6379/0

# Option 2: Upstash Redis (free tier available)
# REDIS_URL=redis://default:[YOUR-PASSWORD]@[YOUR-REDIS-URL]:6379

# Application Settings
SECRET_KEY=change-me-in-production-generate-a-secure-random-key
ENVIRONMENT=development

# Supabase Settings (optional - for Supabase Auth)
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_KEY=your-supabase-anon-key

# API Keys
# YAHOO_CLIENT_ID=your-yahoo-client-id
# YAHOO_CLIENT_SECRET=your-yahoo-client-secret
