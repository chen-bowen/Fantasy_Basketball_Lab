{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--app-dir", "backend", "--port", "8010"],
      "port": 8010
    },
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--prefix", "web", "vite", "web", "--port", "5174", "--strictPort"],
      "env": { "API_URL": "http://localhost:8010" },
      "port": 5174
    },
    {
      "name": "api-check",
      "runtimeExecutable": "backend/.venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--app-dir", "backend", "--port", "8012"],
      "port": 8012
    },
    {
      "name": "web-check",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--prefix", "web", "vite", "web", "--port", "5175", "--strictPort"],
      "env": { "API_URL": "http://localhost:8012" },
      "port": 5175
    }
  ]
}
